// ============================================================
// Hyperlocal Marketplace API
// MySQL + Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER
// ============================================================

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  phone        String
  passwordHash String

  role String @default("SUPER_SELLER")
  // SYSTEM_USER
  // SUPER_SELLER
  // SELLER_ADMIN

  status String @default("PENDING_APPROVAL")
  // PENDING_APPROVAL
  // APPROVED
  // REJECTED
  // ACTIVE
  // SUSPENDED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shops                Shop[]
  applications         SuperSellerApplication[] @relation("ApplicantUser")
  reviewedApplications SuperSellerApplication[] @relation("ReviewerUser")

  repairJobsAssigned RepairJob[]    @relation("AssignedUser")
  repairUpdates      RepairUpdate[]

  @@index([role])
  @@index([status])
}

// ============================================================
// SUPER SELLER APPLICATION
// ============================================================

model SuperSellerApplication {
  id String @id @default(uuid())

  userId String
  user   User   @relation("ApplicantUser", fields: [userId], references: [id], onDelete: Cascade)

  shopName String
  shopType String
  phone    String
  address  String @db.Text

  businessDocUrl String? @db.Text

  status String @default("PENDING")
  // PENDING
  // APPROVED
  // REJECTED

  reviewedBySystemUserId String?
  reviewedByUser         User?   @relation("ReviewerUser", fields: [reviewedBySystemUserId], references: [id], onDelete: SetNull)

  reviewedAt      DateTime?
  rejectionReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([reviewedBySystemUserId])
}

// ============================================================
// SHOP
// ============================================================

model Shop {
  id String @id @default(uuid())

  ownerUserId String
  ownerUser   User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  name String
  type String

  description String? @db.Text

  phone          String
  whatsappNumber String

  address String @db.Text

  latitude  Float
  longitude Float

  isActive   Boolean @default(false)
  isVerified Boolean @default(false)

  openingHours String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  offers           Offer[]
  enquiries        WhatsAppEnquiry[]
  visitorAnalytics VisitorAnalytics[]

  repairCustomers RepairCustomer[]
  repairJobs      RepairJob[]

  @@index([ownerUserId])
  @@index([isActive])
  @@index([isVerified])
  @@index([latitude, longitude])
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id String @id @default(uuid())

  name String
  slug String @unique

  type String @default("accessory")
  // accessory
  // repair

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([type])
  @@index([isActive])
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name  String
  brand String?
  sku   String?

  pricePaise          Int
  compareAtPricePaise Int?

  stock Int @default(0)

  status String @default("ACTIVE")
  // ACTIVE
  // INACTIVE
  // OUT_OF_STOCK
  // ARCHIVED

  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images    ProductImage[]
  enquiries WhatsAppEnquiry[]

  @@index([shopId])
  @@index([shopId, status])
  @@index([categoryId])
  @@index([categoryId, status])
  @@index([name])
  @@index([sku])
}

// ============================================================
// PRODUCT IMAGE
// ============================================================

model ProductImage {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url     String  @db.Text
  altText String?

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, position])
}

// ============================================================
// OFFER
// ============================================================

model Offer {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  title String

  discountType String @default("PERCENTAGE")
  // PERCENTAGE
  // FIXED

  discountValue Int

  startsAt DateTime?
  endsAt   DateTime?

  status String @default("ACTIVE")
  // ACTIVE
  // INACTIVE
  // EXPIRED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([shopId, status])
  @@index([startsAt, endsAt])
}

// ============================================================
// WHATSAPP ENQUIRY
// ============================================================

model WhatsAppEnquiry {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String

  message String @db.Text

  whatsappUrl String @db.Text

  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([shopId, createdAt])
  @@index([productId])
  @@index([productId, createdAt])
}

// ============================================================
// VISITOR ANALYTICS
// ============================================================

model VisitorAnalytics {
  id String @id @default(uuid())

  visitorId String

  ipHash String

  userAgent String? @db.Text

  pageUrl String @db.Text

  actionType String
  // PAGE_VIEW
  // NEARBY_SEARCH
  // WHATSAPP_ENQUIRY_CLICK

  shopId String?
  shop   Shop?   @relation(fields: [shopId], references: [id], onDelete: SetNull)

  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([timestamp, actionType])
  @@index([shopId])
  @@index([shopId, timestamp])
  @@index([visitorId, timestamp])
}

// ============================================================
// REPAIR CUSTOMER
// ============================================================

model RepairCustomer {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name  String
  phone String
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs RepairJob[]

  @@index([shopId])
  @@index([phone])
  @@index([email])
}

// ============================================================
// REPAIR JOB
// ============================================================

model RepairJob {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  customerName  String
  customerPhone String

  repairCustomerId String?
  repairCustomer   RepairCustomer? @relation(fields: [repairCustomerId], references: [id], onDelete: SetNull)

  deviceId String

  problemDescription String @db.Text

  status String @default("SUBMITTED")
  // SUBMITTED
  // UNDER_REVIEW
  // QUOTED
  // APPROVED
  // IN_PROGRESS
  // READY
  // COMPLETED
  // CANCELLED
  // NOT_REPAIRABLE

  estimatedCostPaise Int?

  isSellable Boolean @default(false)

  assignedToUserId String?
  assignedToUser   User?   @relation("AssignedUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates RepairUpdate[]

  @@index([shopId])
  @@index([shopId, status])
  @@index([shopId, status, createdAt])
  @@index([repairCustomerId])
  @@index([assignedToUserId])
}

// ============================================================
// REPAIR UPDATE
// ============================================================

model RepairUpdate {
  id String @id @default(uuid())

  repairJobId String
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  authorUserId String
  authorUser   User   @relation(fields: [authorUserId], references: [id])

  status String

  note String @db.Text

  estimatedCostPaise Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repairJobId])
  @@index([repairJobId, createdAt])
  @@index([authorUserId])
}

// ============================================================
// LANDING PAGE SECTION
// ============================================================

model LandingPageSection {
  id String @id @default(uuid())

  key String @unique

  title String

  subtitle String?

  body String? @db.Text

  imageUrl String? @db.Text

  ctaLabel String?

  ctaUrl String? @db.Text

  isPublished Boolean @default(true)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([isPublished, sortOrder])
}
