// Prisma Schema for Dynamic Landing Page, Seller Dashboard, and System Admin API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String
  passwordHash String
  role         String   @default("SUPER_SELLER") // SYSTEM_USER, SUPER_SELLER, SELLER_ADMIN
  status       String   @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, ACTIVE, SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shops                Shop[]
  applications         SuperSellerApplication[] @relation("ApplicantUser")
  reviewedApplications SuperSellerApplication[] @relation("ReviewerUser")
  repairJobsAssigned   RepairJob[]              @relation("AssignedUser")
  repairUpdates        RepairUpdate[]
}

model SuperSellerApplication {
  id                     String    @id @default(uuid())
  userId                 String
  user                   User      @relation("ApplicantUser", fields: [userId], references: [id], onDelete: Cascade)
  shopName               String
  shopType               String
  phone                  String
  address                String
  businessDocUrl         String?
  status                 String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBySystemUserId String?
  reviewedByUser         User?     @relation("ReviewerUser", fields: [reviewedBySystemUserId], references: [id])
  reviewedAt             DateTime?
  rejectionReason        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
}

model Shop {
  id             String   @id @default(uuid())
  ownerUserId    String
  ownerUser      User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name           String
  type           String
  description    String?
  phone          String
  whatsappNumber String
  address        String
  latitude       Float
  longitude      Float
  isActive       Boolean  @default(false)
  isVerified     Boolean  @default(false)
  openingHours   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products         Product[]
  offers           Offer[]
  enquiries        WhatsAppEnquiry[]
  visitorAnalytics VisitorAnalytics[]
  repairCustomers  RepairCustomer[]
  repairJobs       RepairJob[]

  @@index([isActive, isVerified, latitude, longitude])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  type      String    @default("accessory") // e.g. "accessory", "repair"
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                  String   @id @default(uuid())
  shopId              String
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  categoryId          String
  category            Category @relation(fields: [categoryId], references: [id])
  name                String
  brand               String?
  sku                 String?
  pricePaise          Int
  compareAtPricePaise Int?
  stock               Int      @default(0)
  status              String   @default("ACTIVE")
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  images    ProductImage[]
  enquiries WhatsAppEnquiry[]

  @@index([shopId, status])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Offer {
  id            String    @id @default(uuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title         String
  discountType  String    @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue Int
  startsAt      DateTime?
  endsAt        DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WhatsAppEnquiry {
  id            String   @id @default(uuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  customerName  String
  customerPhone String
  message       String
  whatsappUrl   String
  ipAddress     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopId, createdAt])
}

model VisitorAnalytics {
  id         String   @id @default(uuid())
  visitorId  String
  ipHash     String
  userAgent  String?
  pageUrl    String
  actionType String // PAGE_VIEW, NEARBY_SEARCH, WHATSAPP_ENQUIRY_CLICK
  shopId     String?
  shop       Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  timestamp  DateTime @default(now())

  @@index([timestamp, actionType])
}

model RepairCustomer {
  id        String      @id @default(uuid())
  shopId    String
  shop      Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  jobs      RepairJob[]
}

model RepairJob {
  id                 String          @id @default(uuid())
  shopId             String
  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerName       String
  customerPhone      String
  repairCustomerId   String?
  repairCustomer     RepairCustomer? @relation(fields: [repairCustomerId], references: [id])
  deviceId           String
  problemDescription String
  status             String          @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, QUOTED, APPROVED, IN_PROGRESS, READY, COMPLETED, CANCELLED, NOT_REPAIRABLE
  estimatedCostPaise Int?
  isSellable         Boolean         @default(false)
  assignedToUserId   String?
  assignedToUser     User?           @relation("AssignedUser", fields: [assignedToUserId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  updates RepairUpdate[]

  @@index([shopId, status, createdAt])
}

model RepairUpdate {
  id                 String    @id @default(uuid())
  repairJobId        String
  repairJob          RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  authorUserId       String
  authorUser         User      @relation(fields: [authorUserId], references: [id])
  status             String
  note               String
  estimatedCostPaise Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model LandingPageSection {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  subtitle    String?
  body        String?
  imageUrl    String?
  ctaLabel    String?
  ctaUrl      String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
